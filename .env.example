# Gemini API keys, comma-separated.
GEMINI_API_KEYS=

# Alternative form, easier to manage in the Vercel dashboard:
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Model id. Kept as an env var rather than a literal because Gemini model ids
# move quickly. Verify against https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash

# Retrieval strategy. Only "lexical" is implemented today; any other value logs a
# warning and falls back to it. /api/health always reports what is actually
# running, not what was requested.
RETRIEVER=lexical

# Requests allowed per caller per minute on /api/chat. Default 20.
# Counted in memory, so on a serverless host each instance counts separately.
RATE_LIMIT_PER_MINUTE=20
